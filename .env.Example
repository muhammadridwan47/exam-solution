# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== LLM (array) =====
# Endpoint apa pun yang kompatibel OpenAI (/chat/completions): MIDAS, Keton, Vikey, Ollama, ...
# HOST boleh base URL (…/v1) atau endpoint penuh (…/v1/chat/completions)
# BINDING_KEY memakai format pynput: 6, ctrl+1, cmd+shift+2, f6, ctrl+alt+space
# AKSI: AUDIO=false -> screenshot; AUDIO=true -> hotkey toggle rekam suara lalu proses
#        (butuh sounddevice, scipy, numpy, openai-whisper)
# BINDING_KEY dan NAME harus unik antar entri.
# Opsional: TEMPERATURE (0.1), MAX_TOKENS (tidak dikirim bila kosong), TIMEOUT (120)

LLM.1.NAME=MIDAS
LLM.1.HOST=https://midas-stage.telkomdigital.id/v1
LLM.1.KEY=
LLM.1.MODEL=dpe/alias/code-fast
LLM.1.BINDING_KEY=6
LLM.1.AUDIO=false

LLM.2.NAME=Keton
LLM.2.HOST=https://rtr.keton.id/v1
LLM.2.KEY=
LLM.2.MODEL=ujian
LLM.2.BINDING_KEY=7
LLM.2.AUDIO=false
LLM.2.TIMEOUT=120

LLM.3.NAME=Vikey
LLM.3.HOST=https://api.vikey.ai/v1
LLM.3.KEY=
LLM.3.MODEL=deepseek/deepseek-v4.1-flash
LLM.3.BINDING_KEY=ctrl+1
LLM.3.AUDIO=false

LLM.4.NAME=Vikey-Audio
LLM.4.HOST=https://api.vikey.ai/v1
LLM.4.KEY=
LLM.4.MODEL=deepseek/deepseek-v4.1-flash
LLM.4.BINDING_KEY=ctrl+2
LLM.4.AUDIO=true

# Ollama lokal (opsional)
# LLM.5.NAME=Ollama
# LLM.5.HOST=http://localhost:11434/v1
# LLM.5.KEY=ollama
